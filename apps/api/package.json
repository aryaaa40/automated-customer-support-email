{
  "name": "@email-routing/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "process-inbox": "nest build && node dist/cli.js process-inbox",
    "seed": "nest build && node dist/cli.js seed",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "nest build && node dist/cli.js migrate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@email-routing/shared": "workspace:*",
    "@nestjs/common": "^11.2.12",
    "@nestjs/core": "^11.2.12",
    "@nestjs/platform-express": "^11.2.12",
    "drizzle-orm": "~0.44.7",
    "mailparser": "^3.15.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.12",
    "@swc/cli": "^0.8.2",
    "@swc/core": "^1.16.22",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.20.7",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "~0.31.11",
    "nodemailer": "^7.0.13",
    "typescript": "~5.9.3",
    "unplugin-swc": "^1.6.0",
    "vitest": "^3.2.7"
  }
}
